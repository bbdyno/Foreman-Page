{
  "name": "foreman-page-tools",
  "private": true,
  "type": "module",
  "description": "Build tools for the Foreman site: vendored fonts and icons, brand theme, product screens, pages and the promo film.",
  "scripts": {
    "vendor": "node vendor.mjs",
    "theme": "node theme/from-brand.mjs && node theme/tokens.mjs",
    "brand": "node brand.mjs",
    "screens": "node screens.mjs",
    "site": "node site/build.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@phosphor-icons/core": "2.1.1",
    "playwright": "1.64.1",
    "pretendard": "1.3.9"
  }
}
